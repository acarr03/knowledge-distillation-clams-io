<%- include('layout', { body: `
<div id="shadow-detail-page" data-id="${id}">
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
      <a href="/shadow" class="text-gray-500 hover:text-gray-300 text-sm">&larr; Back</a>
      <h1 class="text-2xl font-bold">Shadow #<span id="s-id">${id}</span></h1>
      <span id="s-status-badge"></span>
    </div>
  </div>

  <!-- Metadata row -->
  <div id="s-meta" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3 mb-6 text-sm"></div>

  <!-- Captured request context (collapsible) -->
  <details class="bg-gray-900 rounded-lg border border-gray-800 mb-4">
    <summary class="px-5 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide cursor-pointer hover:text-gray-400">Captured Claude request (system / messages / tools)</summary>
    <div class="px-5 pb-4 space-y-3">
      <div>
        <div class="text-xs text-gray-600 mb-1">System</div>
        <pre id="s-system" class="text-xs text-gray-400 whitespace-pre-wrap max-h-48 overflow-auto">None</pre>
      </div>
      <div>
        <div class="text-xs text-gray-600 mb-1">Messages</div>
        <pre id="s-messages" class="text-xs text-gray-400 whitespace-pre-wrap max-h-72 overflow-auto">None</pre>
      </div>
      <div>
        <div class="text-xs text-gray-600 mb-1">Tools</div>
        <pre id="s-tools" class="text-xs text-gray-400 whitespace-pre-wrap max-h-48 overflow-auto">None</pre>
      </div>
    </div>
  </details>

  <!-- Side-by-side answers -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
    <div class="bg-gray-900 rounded-lg border border-gray-800 p-5">
      <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Claude answer</h2>
      <div id="s-claude" class="text-gray-200 whitespace-pre-wrap max-h-[520px] overflow-auto text-sm"></div>
    </div>
    <div class="bg-gray-900 rounded-lg border border-clams-700/30 p-5">
      <div class="flex items-center justify-between mb-2 gap-2">
        <h2 class="text-xs font-semibold text-clams-500 uppercase tracking-wide">Local answer</h2>
        <div class="flex items-center gap-2">
          <select id="s-model" class="bg-gray-800 border border-gray-700 text-gray-200 rounded px-2 py-1 text-xs min-w-[180px]"></select>
          <button id="s-run" onclick="shadowReplay()" class="bg-clams-700 hover:bg-clams-600 text-white px-3 py-1 rounded text-xs font-medium">Run local model</button>
        </div>
      </div>
      <div id="s-local" class="text-gray-200 whitespace-pre-wrap max-h-[520px] overflow-auto text-sm"></div>
      <div id="s-local-meta" class="text-xs text-gray-600 mt-2"></div>
    </div>
  </div>

  <!-- Verdict controls -->
  <div class="bg-gray-900 rounded-lg border border-clams-700/30 p-5">
    <h2 class="text-xs font-semibold text-clams-500 uppercase tracking-wide mb-4">Engineer Verdict</h2>
    <div class="mb-4">
      <label class="block text-xs text-gray-500 mb-1">Review Notes</label>
      <textarea id="s-notes" rows="3" class="w-full bg-gray-800 border border-gray-700 text-gray-200 rounded px-3 py-2 text-sm" placeholder="How does the local answer compare? What's missing or wrong?"></textarea>
    </div>
    <div class="mb-4">
      <label class="block text-xs text-gray-500 mb-1">Failure tags — click to toggle, or type a custom one + Enter</label>
      <div id="s-tag-chips" class="flex flex-wrap gap-2 mb-2"></div>
      <input id="s-tag-input" type="text" placeholder="custom tag…" class="bg-gray-800 border border-gray-700 text-gray-200 rounded px-2 py-1.5 text-sm w-64">
    </div>
    <div class="flex flex-wrap gap-3">
      <button onclick="submitVerdict('local_better')" class="bg-green-700 hover:bg-green-600 text-white px-4 py-2 rounded text-sm font-medium">Local better</button>
      <button onclick="submitVerdict('equivalent')" class="bg-blue-700 hover:bg-blue-600 text-white px-4 py-2 rounded text-sm font-medium">Equivalent</button>
      <button onclick="submitVerdict('claude_better')" class="bg-amber-700 hover:bg-amber-600 text-white px-4 py-2 rounded text-sm font-medium">Claude better</button>
      <button onclick="submitVerdict('reject')" class="bg-red-700 hover:bg-red-600 text-white px-4 py-2 rounded text-sm font-medium">Reject</button>
    </div>
    <div id="s-toast" class="mt-3 text-sm hidden"></div>
  </div>
</div>
` }) %>
