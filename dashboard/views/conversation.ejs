<%- include('layout', { body: `
<div id="conversation-page" data-cid="${cid}">
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
      <a href="/conversations" class="text-gray-500 hover:text-gray-300 text-sm">&larr; Back</a>
      <h1 class="text-2xl font-bold">Conversation</h1>
      <span id="c-status-badges" class="flex gap-2"></span>
    </div>
  </div>

  <div id="c-meta" class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-6 text-sm"></div>

  <div id="c-thread" class="space-y-4"></div>

  <div class="bg-gray-900 rounded-lg border border-clams-700/30 p-5 mt-6">
    <h2 class="text-xs font-semibold text-clams-500 uppercase tracking-wide mb-4">Approve conversation</h2>
    <p class="text-xs text-gray-500 mb-3">Edits in the turns above are saved with your decision. Approving marks the whole thread ready and exports it as one multi-turn training example.</p>
    <div class="mb-4">
      <label class="block text-xs text-gray-500 mb-1">Review Notes (whole conversation)</label>
      <textarea id="c-notes" rows="2" class="w-full bg-gray-800 border border-gray-700 text-gray-200 rounded px-3 py-2 text-sm"></textarea>
    </div>
    <div class="flex gap-3">
      <button onclick="submitConversationReview(true)" class="bg-green-700 hover:bg-green-600 text-white px-5 py-2 rounded text-sm font-medium">Approve conversation</button>
      <button onclick="submitConversationReview(false)" class="bg-red-700 hover:bg-red-600 text-white px-5 py-2 rounded text-sm font-medium">Reject</button>
    </div>
    <div id="c-toast" class="mt-3 text-sm hidden"></div>
  </div>
</div>
` }) %>
